MYSQL_DATABASE=trainflow
MYSQL_USER=trainflow
MYSQL_PASSWORD=<mot_de_passe_mysql>
MYSQL_HOST=localhost
MYSQL_PORT=3306
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/trainflow?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=trainflow
SPRING_DATASOURCE_PASSWORD=<mot_de_passe_mysql>
JWT_SECRET=<secret_jwt_long_et_aleatoire>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
# Facultatif : sans surcharge, le backend utilise <racine>/storage/cv
# CV_STORAGE_DIR=C:/chemin/absolu/vers/storage/cv
MAX_CV_FILE_SIZE_MB=10
# Facultatif : sans surcharge, le backend utilise <racine>/storage/documents
# DOCUMENT_STORAGE_PATH=C:/chemin/absolu/vers/storage/documents
DOCUMENT_MAX_SIZE_MB=10
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:3b
CV_LLM_MODEL=qwen2.5:1.5b
# Limites dédiées au modèle léger d'analyse des CV.
CV_LLM_MAX_TOKENS=1024
CV_LLM_MAX_INPUT_CHARS=8000
CV_LLM_KEEP_ALIVE=30s
LOCAL_LLM_TIMEOUT_SECONDS=600
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_TEMPERATURE=0
LOCAL_LLM_KEEP_ALIVE=0s
LOCAL_LLM_NUM_CTX=8192
LOCAL_LLM_NUM_THREAD=6
LOCAL_LLM_NUM_BATCH=512
SEED_DEMO_DATA=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
