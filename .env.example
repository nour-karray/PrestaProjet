POSTGRES_DB=prestacode
POSTGRES_USER=prestacode
POSTGRES_PASSWORD=<mot_de_passe_postgresql>
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000
DATABASE_URL=postgresql+psycopg://prestacode:<mot_de_passe_postgresql>@localhost:5432/prestacode
DATABASE_URL_DOCKER=postgresql+psycopg://prestacode:<mot_de_passe_postgresql>@postgres:5432/prestacode
JWT_SECRET=<secret_jwt_long_et_aleatoire>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_COOKIE_SECURE=false
# Facultatif : sans surcharge, le backend utilise <racine>/storage/cv
# CV_STORAGE_DIR=C:/chemin/absolu/vers/storage/cv
MAX_CV_FILE_SIZE_MB=10
# Facultatif : sans surcharge, le backend utilise <racine>/storage/documents
# DOCUMENT_STORAGE_PATH=C:/chemin/absolu/vers/storage/documents
DOCUMENT_MAX_SIZE_MB=10
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_URL_DOCKER=http://host.docker.internal:11434
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
LOCAL_LLM_TIMEOUT_SECONDS=300
PROGRAM_GENERATION_TIMEOUT_SECONDS=60
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_TEMPERATURE=0
SEED_DEMO_DATA=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Base réservée aux tests PostgreSQL; son nom doit se terminer par _test.
POSTGRES_TEST_DATABASE_URL=postgresql+psycopg://prestacode:<mot_de_passe_postgresql>@localhost:5432/prestacode_test
