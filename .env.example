POSTGRES_DB=trainflow
POSTGRES_USER=trainflow
POSTGRES_PASSWORD=<mot_de_passe_postgresql>
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
SPRING_BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
DATABASE_URL=postgresql+psycopg://trainflow:<mot_de_passe_postgresql>@localhost:5432/trainflow
DATABASE_URL_DOCKER=postgresql+psycopg://trainflow:<mot_de_passe_postgresql>@postgres:5432/trainflow
JWT_SECRET=<secret_jwt_long_et_aleatoire>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
AUTH_COOKIE_SECURE=false
# Facultatif : sans surcharge, le backend utilise <racine>/storage/cv
# CV_STORAGE_DIR=C:/chemin/absolu/vers/storage/cv
MAX_CV_FILE_SIZE_MB=10
# Facultatif : sans surcharge, le backend utilise <racine>/storage/documents
# DOCUMENT_STORAGE_PATH=C:/chemin/absolu/vers/storage/documents
DOCUMENT_MAX_SIZE_MB=10
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_URL_DOCKER=http://host.docker.internal:11434
LOCAL_LLM_MODEL=qwen-prestacode-v3:latest
CV_LLM_MODEL=qwen2.5:1.5b
# Limites dédiées au modèle léger d'analyse des CV.
CV_LLM_MAX_TOKENS=1024
CV_LLM_MAX_INPUT_CHARS=8000
CV_LLM_KEEP_ALIVE=30s
LOCAL_LLM_TIMEOUT_SECONDS=600
LOCAL_LLM_MAX_TOKENS=4096
LOCAL_LLM_TEMPERATURE=0
LOCAL_LLM_KEEP_ALIVE=1h
LOCAL_LLM_NUM_CTX=8192
LOCAL_LLM_NUM_THREAD=6
LOCAL_LLM_NUM_BATCH=512
SEED_DEMO_DATA=false
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
# Base réservée aux tests PostgreSQL; son nom doit se terminer par _test.
POSTGRES_TEST_DATABASE_URL=postgresql+psycopg://trainflow:<mot_de_passe_postgresql>@localhost:5432/trainflow_test
